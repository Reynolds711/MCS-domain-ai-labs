          },
          "developing": {
            "points": 1,
            "descriptor": "Basic vocabulary; multiple errors that don't impede understanding"
          },
          "beginning": {
            "points": 0,
            "descriptor": "Limited vocabulary; errors impede understanding"
          }
        }
      },
